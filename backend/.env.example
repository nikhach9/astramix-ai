ASTRAMIX_DEBUG=false

# Note: Model path artifacts (xgboost.joblib) are resolved dynamically relative
# to the project workspace root folder in artifacts/models/strength/baseline/.
# Comma-separated list of allowed frontend origins for CORS.
ASTRAMIX_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# API host and port configurations (used by startup scripts / uvicorn)
ASTRAMIX_HOST=127.0.0.1
ASTRAMIX_PORT=8000
